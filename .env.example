# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Resend (transactional emails — purchase confirmations)
# Sign up free at https://resend.com, then verify your sending domain.
RESEND_API_KEY=re_your_resend_api_key_here
# Optional: defaults to "Killer Party <onboarding@resend.dev>" for testing.
# Replace with a verified address once your domain is set up.
RESEND_FROM_EMAIL="Killer Party <hello@yourdomain.com>"

# Redis (Upstash) for games, game codes and saved purchases.
# Vercel: Storage > Create > Upstash for Redis, connect it to this project.
# Either pair of names works.

KV_REST_API_URL=
KV_REST_API_TOKEN=
# or: UPSTASH_REDIS_REST_URL= and UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Testing: enables the unpaid /test generator. Leave unset in production.
ENABLE_TEST_GENERATE=
# Customer support inbox (optional; a default is built in). Never shown to customers.
SUPPORT_EMAIL=

# Optional: passcode for the /test page (a default is built in)
TEST_PASSCODE=
